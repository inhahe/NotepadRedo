<Window x:Class="TreeNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TreeNotepad" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- ============ Menu ============ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New"        Click="New_Click"    InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..."    Click="Open_Click"   InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save"       Click="Save_Click"   InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xit"       Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo"  Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo"  Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cu_t"   Command="Cut"/>
                <MenuItem Header="_Copy"  Command="Copy"/>
                <MenuItem Header="_Paste" Command="Paste"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="WordWrapItem" Header="_Word Wrap" IsCheckable="True"
                          IsChecked="True" Click="WordWrap_Click"/>
                <MenuItem x:Name="ShowTreeItem" Header="Show _History Tree" IsCheckable="True"
                          IsChecked="True" Click="ShowTree_Click"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Autosave (crash recovery)">
                    <MenuItem x:Name="AutoOff"  Header="Off"        IsCheckable="True"
                              Tag="0"   Click="AutosaveInterval_Click"/>
                    <MenuItem x:Name="Auto15"   Header="Every 15 seconds" IsCheckable="True"
                              Tag="15"  Click="AutosaveInterval_Click"/>
                    <MenuItem x:Name="Auto30"   Header="Every 30 seconds" IsCheckable="True"
                              IsChecked="True" Tag="30"  Click="AutosaveInterval_Click"/>
                    <MenuItem x:Name="Auto60"   Header="Every minute"     IsCheckable="True"
                              Tag="60"  Click="AutosaveInterval_Click"/>
                    <MenuItem x:Name="Auto300"  Header="Every 5 minutes"  IsCheckable="True"
                              Tag="300" Click="AutosaveInterval_Click"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ============ Status bar ============ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="CaretStatus" Text="Ln 1, Col 1"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CountStatus" Text="0 chars"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="NodeStatus" Text="node #0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="SaveStatus" Text="Saved" FontWeight="Bold"
                           Foreground="ForestGreen"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ============ Body: editor + splitter + tree ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="TreeColumn" Width="340" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Editor" Grid.Column="0"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="14"
                     IsUndoEnabled="False"
                     Padding="6"
                     TextChanged="Editor_TextChanged"
                     SelectionChanged="Editor_SelectionChanged"/>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <DockPanel x:Name="TreePanel" Grid.Column="2" Margin="4">
                <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="6" Margin="0,0,0,4"
                        BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="History Tree" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Preview chars:" VerticalAlignment="Center"/>
                            <Slider x:Name="PreviewSlider" Width="120" Margin="6,0"
                                    Minimum="5" Maximum="80" Value="30"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="PreviewSlider_ValueChanged"/>
                            <TextBlock x:Name="PreviewLenLabel" Text="30" VerticalAlignment="Center" Width="24"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TreeView x:Name="Tree"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          BorderBrush="#DDDDDD" BorderThickness="1">
                    <!-- Neutralise the default TreeViewItem selection highlight, which
                         paints the header blue and whites-out the label (making the
                         "(empty)" preview appear to vanish when clicked). Selection is
                         instead shown by our own IsCurrent / IsSelected border styling. -->
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#222222"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#222222"/>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border CornerRadius="3" Padding="6,3" Margin="0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#EAEAEA"/>
                                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="#FFF3D9"/>
                                                <Setter Property="BorderBrush" Value="#E0A93B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="13" Foreground="#222222"/>
                                    <TextBlock Text="{Binding Meta}" Foreground="#888888" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
