<Application x:Class="NotepadRedo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Base palette so every DynamicResource "Theme.*" key resolves. The plain
                 NotepadRedo.exe uses these (its original colours); the stylised variant exes
                 merge an overriding palette + Controls.xaml at startup (see App.xaml.cs).
                 Shared.xaml holds the styles every build uses. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.Base.xaml"/>
                <ResourceDictionary Source="Themes/Shared.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
